# Copy this file to .env and fill in your credentials
# DO NOT commit .env to git

# Reddit API credentials (get from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=SentimentAnalysis/1.0 by YourUsername

# Alpha Vantage API (get from https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# MongoDB connection (local default shown)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=sentiment_stock_db

# PostgreSQL connection (local default shown)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password
PG_DB=sentiment_stock
